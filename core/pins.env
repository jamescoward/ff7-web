# Pinned toolchain and upstream sources for the Wasm core build.
# Changing any value here is a toolchain change: record why in the PR.

# PCSX ReARMed (GPL-2.0), libretro fork. Survey baseline commit.
PCSX_REARMED_URL=https://github.com/libretro/pcsx_rearmed
PCSX_REARMED_COMMIT=7b0e8f8fadfbce3d170d195b9d9eecaabfa08c8e

# Emscripten SDK. The tag must resolve to EMSDK_COMMIT (checked by build.sh).
EMSDK_URL=https://github.com/emscripten-core/emsdk
EMSDK_VERSION=4.0.23
EMSDK_COMMIT=c0bb220cb6e6f4e0fabb6f6db9efd53390ef5e56
