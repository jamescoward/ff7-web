{
  "$schema": "../../schema/scenario.schema.json",
  "name": "touch-1-first-battle",
  "description": "#120 stretch 1, generated by runner/test/unit/playthrough-scenarios.js from the touch layer (field-drag.js directions, FIELD_ACTIONS, the battle panel plan): from reactor-entrance, drag up with Interact taps until battle; two Attack turns with the battle panel (Command 1, Confirm); Command 1 / Confirm taps and the classic pad ○ until field mode; Interact taps until a still picture; drag up-left until the field ID leaves md1stin; wait for the field to load. Needs memory names game_state, map_cur, loading, widget, row0. Metrics: battle_wait, turn1, t1_target, t1_done, turn2, end_wait, next_wait.",
  "steps": [
    {
      "wait": {
        "until": {
          "mem": "game_state",
          "equals": 2
        },
        "timeout": 1800,
        "press": {
          "buttons": [
            "up",
            "circle"
          ],
          "every": 20,
          "hold": 15
        }
      },
      "metric": "battle_wait"
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 65535
        },
        "timeout": 600
      }
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 1
        },
        "timeout": 1800
      },
      "metric": "turn1"
    },
    {
      "wait": {
        "frames": 30
      }
    },
    {
      "wait": {
        "until": {
          "mem": "row0",
          "equals": 0
        },
        "timeout": 30
      }
    },
    {
      "buttons": [
        "circle"
      ],
      "frames": 4
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 0
        },
        "timeout": 30
      },
      "metric": "t1_target"
    },
    {
      "buttons": [
        "circle"
      ],
      "frames": 4
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 65535
        },
        "timeout": 30
      },
      "metric": "t1_done"
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 1
        },
        "timeout": 3600
      },
      "metric": "turn2"
    },
    {
      "wait": {
        "frames": 30
      }
    },
    {
      "wait": {
        "until": {
          "mem": "row0",
          "equals": 0
        },
        "timeout": 30
      }
    },
    {
      "buttons": [
        "circle"
      ],
      "frames": 4
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 0
        },
        "timeout": 30
      }
    },
    {
      "buttons": [
        "circle"
      ],
      "frames": 4
    },
    {
      "wait": {
        "until": {
          "mem": "widget",
          "equals": 65535
        },
        "timeout": 30
      }
    },
    {
      "wait": {
        "until": {
          "mem": "game_state",
          "equals": 1
        },
        "timeout": 10800,
        "press": {
          "buttons": [
            "circle"
          ],
          "every": 30,
          "hold": 4
        }
      },
      "metric": "end_wait"
    },
    {
      "wait": {
        "stillFrames": 300,
        "timeout": 3600,
        "press": {
          "buttons": [
            "circle"
          ],
          "every": 60,
          "hold": 4
        }
      }
    },
    {
      "wait": {
        "until": {
          "mem": "map_cur",
          "differs": 116
        },
        "timeout": 3600,
        "press": {
          "buttons": [
            "up",
            "left"
          ],
          "every": 60,
          "hold": 59
        }
      },
      "metric": "next_wait"
    },
    {
      "wait": {
        "until": {
          "mem": "loading",
          "differs": 2
        },
        "timeout": 600
      }
    },
    {
      "wait": {
        "until": {
          "mem": "loading",
          "equals": 2
        },
        "timeout": 3600
      }
    }
  ]
}
