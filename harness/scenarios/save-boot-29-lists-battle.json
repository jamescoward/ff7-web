{
  "$schema": "../schema/scenario.schema.json",
  "format": 2,
  "tier": 2,
  "name": "save-boot-29-lists-battle",
  "description": "#253: boot harness/saves/disc1-md1stin-battle-lists.json (Cloud alone; author-chosen HP/MP, two magic materia on the weapon, restoratives in inventory slots 0-6), load as save-boot-11 does, and hold Up+Left until a random battle in md1_1. Keeps \"lists-battle\" at the first frame of battle mode, for 29a-29d. match: a rerun from the title snapshot.",
  "boot": {
    "disc": 1,
    "save": "disc1-md1stin-battle-lists",
    "slot": 1
  },
  "memory": {
    "game_state": {
      "addr": "0x8009c560",
      "type": "u16",
      "description": "g_GameState (s16 as u16; confirmed #76): field 1, battle 2, menu 5."
    },
    "map_cur": {
      "addr": "0x8009a05c",
      "type": "u16",
      "description": "g_FieldCurrentMap (s16 as u16; confirmed #77): the field ID."
    },
    "loading": {
      "addr": "0x800965e8",
      "type": "u16",
      "description": "g_IsFieldLoading (s16 as u16; confirmed #77): 2 in a settled field."
    }
  },
  "input": [
    {
      "wait": {
        "until": {
          "mem": "game_state",
          "equals": 1
        },
        "timeout": 3600,
        "press": {
          "buttons": [
            "circle"
          ],
          "every": 30,
          "hold": 4
        }
      }
    },
    {
      "segment": "field-loaded"
    },
    {
      "wait": {
        "until": {
          "mem": "map_cur",
          "equals": 116
        },
        "timeout": 1
      }
    },
    {
      "wait": {
        "frames": 60
      }
    },
    {
      "wait": {
        "until": {
          "mem": "game_state",
          "equals": 2
        },
        "timeout": 9000,
        "press": {
          "buttons": [
            "up",
            "left"
          ],
          "every": 60,
          "hold": 59
        }
      },
      "metric": "battle_wait"
    }
  ],
  "assert": [
    {
      "expect": {
        "mem": "game_state",
        "equals": 2
      }
    },
    {
      "sameState": "rerun",
      "metric": "match"
    }
  ],
  "snapshot": "lists-battle",
  "metrics": [
    "load_done",
    "battle_wait",
    "map_cur",
    "match"
  ]
}
