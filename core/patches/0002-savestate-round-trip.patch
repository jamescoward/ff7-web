--- a/libpcsxcore/psxcounters.c
+++ b/libpcsxcore/psxcounters.c
@@ -600,7 +600,16 @@
         rcnts[3].rate = 1;
         for( i = 0; i < CounterQuantity - 1; ++i )
         {
+            // ff7-web: when the mode gives the rate the state was saved
+            // with, the saved cycleStart/cycle/counterState are already
+            // right. Re-deriving them through _psxRcntWcount drops the
+            // part of a tick elapsed since the last increment (rate > 1),
+            // so the counter would read up to one tick lower than in a
+            // core that never saved and restored.
+            u32 saved_rate = rcnts[i].rate;
             _psxRcntWmode( i, rcnts[i].mode );
+            if (rcnts[i].rate == saved_rate)
+                continue;
             count = (psxRegs.cycle - rcnts[i].cycleStart) / rcnts[i].rate;
             if (count > 0x1000)
                 _psxRcntWcount( i, count & 0xffff );
--- a/libpcsxcore/mdec.c
+++ b/libpcsxcore/mdec.c
@@ -722,9 +722,15 @@
 	if (mdec.block_buffer_pos)
 		v = mdec.block_buffer_pos - mdec.block_buffer;
 	gzfreeze(&v, sizeof(v));
-	mdec.block_buffer_pos = 0;
-	if (v && v < sizeof(mdec.block_buffer))
-		mdec.block_buffer_pos = mdec.block_buffer;
+	// ff7-web: this ran on save as well as on load, and put the position
+	// back to the start of the block, so a save in the middle of a block
+	// changed the running core and a load lost the position. Keep the
+	// position on save; restore it (not the block start) on load.
+	if (Mode == 0) {
+		mdec.block_buffer_pos = 0;
+		if (v && v < sizeof(mdec.block_buffer))
+			mdec.block_buffer_pos = mdec.block_buffer + v;
+	}
 
 	gzfreeze(&mdec.block_buffer, sizeof(mdec.block_buffer));
 	gzfreeze(&mdec.pending_dma1, sizeof(mdec.pending_dma1));
