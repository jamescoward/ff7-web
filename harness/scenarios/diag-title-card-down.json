{
  "$schema": "../schema/scenario.schema.json",
  "format": 2,
  "name": "diag-title-card-down",
  "description": "#74 attempt 2 diagnostic, removed before merge. As diag-title-down, from the title boot point with a blank memory card. Game-agnostic; no FF7 address is used.",
  "tier": 2,
  "boot": {
    "disc": 1,
    "from": "title-card"
  },
  "input": [
    {
      "wait": {
        "stillFrames": 60,
        "timeout": 600,
        "press": {
          "buttons": [
            "down"
          ],
          "every": 30,
          "hold": 4
        }
      },
      "metric": "still"
    }
  ],
  "assert": [
    {
      "sameState": "rerun",
      "metric": "match"
    }
  ],
  "metrics": [
    "still",
    "frames",
    "match",
    "boot_stage",
    "fps"
  ]
}
