{
  "$schema": "../schema/scenario.schema.json",
  "format": 1,
  "name": "disc-boot-smoke",
  "description": "Boots disc 1 from power-on (HLE BIOS) and presses Start for 4 frames every 2 s from frame 300, to skip the pre-title logos and intro (ENDING_SceaLoop, ENDING_Loop) that main() runs before HandleTitle. Checks that SYSTEM.CNF's boot executable is the USA release and that the title screen is reached, and reports frames to the title and the unthrottled speed (#36). Addresses, offsets and hashes are from Xeeynamo/ff7-decomp config/us.yaml and src/main at 9411173 (reference only); see notes/36-disc-boot.md.",
  "tier": 2,
  "boot": {
    "disc": "disc-1"
  },
  "frames": 10800,
  "memory": {
    "ending_head": {
      "addr": "0x800a0000",
      "type": "bytes",
      "len": 4096,
      "description": "First 4 KiB of the ENDING overlay (pre-title logos and intro), linked at 0x800A0000"
    },
    "game_state": {
      "addr": "0x8009c560",
      "type": "u16",
      "description": "g_GameState (field 1, battle 2, world 3, menu 5; none on the title)"
    },
    "overlay_head": {
      "addr": "0x801d0000",
      "type": "bytes",
      "len": 4096,
      "description": "First 4 KiB of the SAVEMENU overlay (read-only data and code), linked at 0x801D0000"
    },
    "title_code": {
      "addr": "0x801d2b58",
      "type": "bytes",
      "len": 4096,
      "description": "First 4 KiB of the title module's code in the SAVEMENU overlay: file offset 0x2B58, linked at 0x801D0000 + 0x2B58"
    }
  },
  "assert": [
    {
      "discFile": "SYSTEM.CNF:BOOT",
      "sha1": "a95e8b16b97071203b953bb81a33980509262f30",
      "metric": "boot_exe_match",
      "note": "SCUS_941.63, USA; source claim from ff7-decomp. Reported only as matched or not."
    },
    {
      "within": 10800,
      "mem": "title_code",
      "equalsDiscFile": {
        "path": "MENU/SAVEMENU.MNU",
        "offset": 11096
      },
      "metric": "title_frame",
      "note": "HandleTitle loads SAVEMENU and runs its title code: the title screen. Hypothesis to confirm on Tier 2."
    }
  ],
  "probes": [
    {
      "within": 10800,
      "mem": "ending_head",
      "equalsDiscFile": {
        "path": "FIELD/ENDING.X",
        "offset": 0
      },
      "metric": "ending_frame",
      "note": "The pre-title ENDING overlay is resident (its loops run before HandleTitle)."
    },
    {
      "within": 10800,
      "mem": "overlay_head",
      "equalsDiscFile": {
        "path": "MENU/SAVEMENU.MNU",
        "offset": 0
      },
      "metric": "overlay_frame",
      "note": "Whether SAVEMENU is loaded at all (its file SHA-1 matched the decomp's on 2026-11-05)."
    },
    {
      "within": 10740,
      "stillFrames": 60,
      "metric": "still_frame",
      "note": "Game-agnostic fallback: the first second-long still, non-blank picture."
    }
  ],
  "metrics": ["boot_stage", "fps", "boot_exe_match", "title_frame", "overlay_frame", "ending_frame", "still_frame", "game_state"],
  "input": [
