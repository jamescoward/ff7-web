{
  "$schema": "../schema/scenario.schema.json",
  "format": 2,
  "name": "diag-title-card-1min",
  "description": "#74 attempt 2 diagnostic, removed before merge. As diag-title-1min, from the title boot point with a blank memory card. Game-agnostic; no FF7 address is used.",
  "tier": 2,
  "boot": {
    "disc": 1,
    "from": "title-card"
  },
  "input": [
    {
      "segment": "title-to-new-game"
    },
    {
      "wait": {
        "frames": 3600
      }
    },
    {
      "wait": {
        "stillFrames": 60,
        "timeout": 600
      },
      "metric": "still"
    }
  ],
  "assert": [
    {
      "sameState": "rerun",
      "metric": "match"
    }
  ],
  "metrics": [
    "still",
    "frames",
    "match",
    "boot_stage",
    "fps"
  ]
}
